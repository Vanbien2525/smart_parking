# Cấu hình máy chủ Socket (Lập trình mạng)
SERVER_HOST=0.0.0.0
SERVER_PORT=5555
CLIENT_CONNECT_HOST=127.0.0.1
HEARTBEAT_TIMEOUT_SECONDS=45

# Cấu hình Cơ sở dữ liệu PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_parking
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cấu hình SMTP Email thật (OTP khôi phục mật khẩu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
OTP_EXPIRE_SECONDS=300

# Cấu hình AI nhận diện biển số (Tầng 1 chính: Gemini 3.8 Flash; dự phòng Cloud khi chạm hạn mức RPD/RPM: Gemini 3.5 Flash Lite; bỏ trống API key để dùng Local YOLO + EasyOCR)
GEMINI_API_KEY="aaaa"
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
