# =============================================================================
# SMART PARKING — CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Lưu ý: Sao chép file này thành .env và điền các giá trị thực tế của bạn.
# Tuyệt đối không commit file .env chứa mật khẩu thật lên Git repository.
# =============================================================================

# 1. Cấu hình Máy chủ Socket (Lập trình mạng Client - Server TCP)
SERVER_HOST=0.0.0.0
SERVER_PORT=5555
CLIENT_CONNECT_HOST=127.0.0.1
HEARTBEAT_TIMEOUT_SECONDS=45
HEARTBEAT_REAP_INTERVAL_SECONDS=10

# 2. Cấu hình Cơ sở dữ liệu PostgreSQL (Hỗ trợ Local & Neon Cloud)
# -----------------------------------------------------------------------------
# CHẾ ĐỘ A: PostgreSQL Local (mặc định khi phát triển cục bộ)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smart_parking
# DB_USER=postgres
# DB_PASSWORD=your_local_postgres_password
# DB_SSLMODE=prefer
# DB_CHANNEL_BINDING=prefer
# DB_CONNECT_TIMEOUT=15
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_TIMEOUT=30

# CHẾ ĐỘ B: Neon PostgreSQL Cloud (Direct Endpoint - AWS Singapore)
# Lưu ý: Dùng endpoint trực tiếp (không có hậu tố -pooler trong giai đoạn kiểm thử)
DB_HOST=ep-example-subdomain.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=smart_parking
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_SSLMODE=require
DB_CHANNEL_BINDING=require
DB_CONNECT_TIMEOUT=15
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30

# 3. Cấu hình SMTP Email (Gửi mã OTP khôi phục mật khẩu tài khoản)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# 4. Cấu hình AI nhận diện biển số xe (Hybrid Pipeline)
# Tầng 1: Gemini Vision API (bỏ trống API key để tự động fallback sang YOLO + EasyOCR cục bộ)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
