/* ============================================================================
   DESIGN DNA STYLESHEET — CHUNG CƯ ĐÀO TIÊN SMART PARKING (PySide6)
   Đồng bộ 100% với design_dna.json & tokens.py
   ============================================================================ */

* {
    font-family: "Segoe UI Variable Text", "Inter", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #0F172A;
}

QMainWindow, QDialog, QWidget#AppWorkspace {
    background-color: #F8FAFC;
}

/* ======================== SIDEBAR TỐI CỐ ĐỊNH ======================== */
QWidget#Sidebar {
    background-color: #0B132B;
    border-right: 1px solid #1E293B;
}

QLabel#SidebarBrandTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
}

QLabel#SidebarBrandSubtitle {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

QLabel#SidebarGroupLabel {
    color: #64748B;
    font-size: 10.5px;
    font-weight: 700;
    padding: 10px 14px 4px 14px;
    text-transform: uppercase;
}

QPushButton.SidebarNavBtn {
    background-color: transparent;
    color: #CBD5E1;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px 8px 8px 0px;
    padding: 9px 14px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    margin: 1px 8px 1px 0px;
}

QPushButton.SidebarNavBtn:hover {
    background-color: #162244;
    color: #FFFFFF;
}

QPushButton.SidebarNavBtn[active="true"] {
    background-color: #1E293B;
    color: #FFFFFF;
    font-weight: 600;
    border-left: 3px solid #2563EB;
}

QPushButton#SidebarCollapseBtn {
    background-color: #111C3A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: 600;
}

QPushButton#SidebarCollapseBtn:hover {
    background-color: #1E293B;
    color: #FFFFFF;
}

/* ======================== TOPBAR MẢNH ======================== */
QWidget#Topbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

QLabel#TopbarTitle {
    color: #0F172A;
    font-size: 17px;
    font-weight: 700;
}

QLabel#TopbarSubtitle {
    color: #64748B;
    font-size: 12px;
}

/* ======================== CARDS & CONTAINERS ======================== */
QFrame.SectionCard, QFrame.StatCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
}

QLabel.CardTitle {
    color: #0F172A;
    font-size: 15px;
    font-weight: 700;
}

QLabel.CardSubtitle {
    color: #64748B;
    font-size: 12px;
}

QLabel.StatLabel {
    color: #64748B;
    font-size: 12px;
    font-weight: 600;
}

QLabel.StatValue {
    color: #0F172A;
    font-size: 25px;
    font-weight: 700;
}

QLabel.StatDelta {
    color: #475569;
    font-size: 11.5px;
}

/* ======================== TYPOGRAPHY CHUYÊN DỤNG ======================== */
QLabel.PageHeading {
    color: #0F172A;
    font-size: 20px;
    font-weight: 700;
}

QLabel.FieldLabel {
    color: #334155;
    font-size: 12px;
    font-weight: 600;
}

QLabel.MutedText {
    color: #64748B;
    font-size: 12px;
}

QLabel.MonoValue {
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", monospace;
    font-weight: 700;
    color: #0F172A;
}

QLabel.PlateBadge {
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", monospace;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    background-color: #FFFFFF;
    color: #0F172A;
    border: 2px solid #0F172A;
    border-radius: 6px;
    padding: 4px 12px;
}

/* ======================== BUTTONS PHÂN CẤP ======================== */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 7px 14px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton[variant="primary"] {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
}
QPushButton[variant="primary"]:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton[variant="teal"] {
    background-color: #0D9488;
    color: #FFFFFF;
    border: 1px solid #0D9488;
}
QPushButton[variant="teal"]:hover {
    background-color: #0F766E;
    border-color: #0F766E;
}

QPushButton[variant="success"] {
    background-color: #16A34A;
    color: #FFFFFF;
    border: 1px solid #16A34A;
}
QPushButton[variant="success"]:hover {
    background-color: #15803D;
    border-color: #15803D;
}

QPushButton[variant="danger"] {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #DC2626;
}
QPushButton[variant="danger"]:hover {
    background-color: #B91C1C;
    border-color: #B91C1C;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    color: #475569;
    border: 1px solid transparent;
}
QPushButton[variant="ghost"]:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

QPushButton[size="sm"] {
    padding: 4px 10px;
    font-size: 12px;
    border-radius: 6px;
}

/* ======================== INPUTS & FORM CONTROLS ======================== */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 7px 10px;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit {
    min-height: 22px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid #2563EB;
    background-color: #FFFFFF;
}

QLineEdit:read-only, QTextEdit:read-only, QPlainTextEdit:read-only, QLineEdit:disabled, QComboBox:disabled {
    background-color: #F1F5F9;
    color: #475569;
    border-color: #E2E8F0;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

/* ======================== TABLES (ENTERPRISE DATA GRID) ======================== */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    gridline-color: #F1F5F9;
    selection-background-color: #EFF6FF;
    selection-color: #0F172A;
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 8px 10px;
    border-bottom: 1px solid #F1F5F9;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #F8FAFC;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 9px 10px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* ======================== TABS ======================== */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    background-color: #FFFFFF;
    padding: 8px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 16px;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
}

/* ======================== BANNERS (KHẨN CẤP & ADMIN READ-ONLY) ======================== */
QFrame#EmergencyBanner {
    background-color: #FEF2F2;
    border-bottom: 2px solid #DC2626;
}

QLabel#EmergencyBannerText {
    color: #991B1B;
    font-weight: 700;
    font-size: 13px;
}

QFrame#ReadOnlyBanner {
    background-color: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 10px;
}

QLabel#ReadOnlyBannerText {
    color: #92400E;
    font-weight: 600;
    font-size: 12.5px;
}

/* ======================== CAMERA VIEWPORT ======================== */
QLabel#CameraViewport {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #334155;
    border-radius: 10px;
    font-weight: 600;
}

/* ======================== SCROLLBAR MẢNH HIỆN ĐẠI ======================== */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
    width: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 28px;
}
