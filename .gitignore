# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual Environment
venv/
.venv/
env/

# Environment variables & secrets
.env

# IDE
.vscode/
.idea/

# Runtime storage (giữ lại thư mục qua .gitkeep)
storage/state/*
!storage/state/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/uploads/cavet/*
!storage/uploads/cavet/.gitkeep
storage/uploads/gates_in/*
!storage/uploads/gates_in/.gitkeep
storage/uploads/gates_out/*
!storage/uploads/gates_out/.gitkeep

# Model weights tải về (nếu nặng)
*.pt
*.onnx

# Local progress tracking (chỉ lưu local, không push lên GitHub)
progress.md
