# =============================================================================
# SMART PARKING — RENDER CLOUD ENVIRONMENT VARIABLES TEMPLATE
# Điền các giá trị này vào mục Environment trong Dashboard Render Web Service
# =============================================================================

# 1. Cấu hình Server Mạng nội bộ
SERVER_HOST=127.0.0.1
SERVER_PORT=5555
HEARTBEAT_TIMEOUT_SECONDS=45
HEARTBEAT_REAP_INTERVAL_SECONDS=10

# 2. Cấu hình Neon PostgreSQL Cloud (Direct Endpoint)
DB_HOST=ep-example-subdomain.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=smart_parking
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_SSLMODE=require
DB_CHANNEL_BINDING=require
DB_CONNECT_TIMEOUT=15
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30

# 3. Cấu hình Email OTP qua HTTPS API (Khắc phục việc Render Free chặn SMTP ports 25/465/587)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Tùy chọn dự phòng: Brevo
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-your-brevo-api-key
# BREVO_SENDER_EMAIL=your_verified_sender@domain.com
# BREVO_SENDER_NAME="Smart Parking Đào Tiên"
